---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RepositoryLink from '../../components/RepositoryLink.astro';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    (b.data.year ?? 0) - (a.data.year ?? 0) ||
    a.data.title.localeCompare(b.data.title, 'en', { sensitivity: 'base' }) ||
    a.id.localeCompare(b.id),
);
---

<BaseLayout>
  {projects.length > 0 && (
    <ul class="project-list">
      {projects.map((project) => (
        <li>
          <article class="project-row">
            <div class="project-copy">
              <h2>
                <a class="project-title" href={`/projects/${project.id}/`}>
                  {project.data.title}
                </a>
                {project.data.repository && (
                  <RepositoryLink
                    href={project.data.repository}
                    title={project.data.title}
                    inline
                  />
                )}
              </h2>
              {project.data.description && <p>{project.data.description}</p>}
            </div>
            {project.data.year && (
              <span class="project-year">{project.data.year}</span>
            )}
          </article>
        </li>
      ))}
    </ul>
  )}
  {projects.length === 0 && <p>No projects published yet.</p>}
</BaseLayout>

<style>
  .project-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-row {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--foreground) 12%, var(--background));
    color: inherit;
    text-decoration: none;
  }

  .project-title {
    color: inherit;
    text-decoration: none;
  }

  .project-title::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .project-title:focus-visible {
    outline: none;
  }

  .project-title:focus-visible::after {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .project-copy {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    flex: 1;
  }

  h2 {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  h2 :global(.repository-link) {
    flex-shrink: 0;
  }

  .project-copy p {
    max-width: 28rem;
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 75%, var(--background));
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .project-year {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--foreground) 75%, var(--background));
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .project-title:hover,
  .project-title:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 40rem) {
    .project-row {
      gap: 2rem;
      padding-block: 1.25rem;
    }
  }
</style>
