<script>
  class WebDemo extends HTMLElement {
    connectedCallback() {
      if (!this.dataset.src) return;
      const frame = document.createElement('iframe');
      frame.title = this.dataset.title ?? 'Interactive demo';
      frame.loading = 'lazy';
      const controller = new AbortController();
      this.cleanup = () => controller.abort();
      const source = new URL(this.dataset.src, location.origin);
      if (this.dataset.molecule)
        source.searchParams.set('molecule', this.dataset.molecule);
      source.searchParams.set(
        'theme',
        document.documentElement.dataset.theme ?? 'light',
      );
      frame.src = source.href;
      this.replaceChildren(frame);
      window.addEventListener(
        'message',
        (event) => {
          if (
            event.origin !== location.origin ||
            event.source !== frame.contentWindow
          )
            return;
          if (
            event.data?.type === 'demo:resize' &&
            Number.isFinite(event.data.height)
          ) {
            frame.style.height = `${Math.min(1400, Math.max(320, event.data.height))}px`;
          }
        },
        { signal: controller.signal },
      );
      const observer = new MutationObserver(() => {
        frame.contentWindow?.postMessage(
          { type: 'demo:theme', theme: document.documentElement.dataset.theme },
          location.origin,
        );
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      controller.signal.addEventListener('abort', () => observer.disconnect());
    }

    private cleanup?: () => void;

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('web-demo'))
    customElements.define('web-demo', WebDemo);
</script>

<style is:global>
  web-demo {
    display: block;
    margin-bottom: 2.5rem;
  }
  web-demo > iframe {
    width: 100%;
    height: 620px;
    border: 0;
  }
</style>
