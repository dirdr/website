---
interface Props {
  href: string;
  title: string;
  inline?: boolean;
  text?: string;
}

const { href, title, inline = false, text } = Astro.props;
const label = text
  ? `${text} for ${title} on GitHub`
  : `View ${title} on GitHub`;
---

<a
  class:list={[
    'repository-link',
    { 'repository-link-inline': inline, 'repository-link-labelled': text },
  ]}
  href={href}
  aria-label={label}
  title={label}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" />
  </svg>
  {text && <span>{text}</span>}
</a>

<style>
  .repository-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.5rem;
    border-radius: 0.25rem;
    color: inherit;
  }

  .repository-link:hover {
    background: color-mix(in srgb, var(--foreground) 6%, var(--background));
  }

  .repository-link-inline {
    width: 1.75em;
    height: 1.75em;
    margin: -0.25em 0;
    vertical-align: -0.125em;
  }

  .repository-link-inline svg {
    width: 1em;
    height: 1em;
  }

  .repository-link-labelled {
    width: fit-content;
    gap: 0.5rem;
    padding-inline: 0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .repository-link-labelled:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
