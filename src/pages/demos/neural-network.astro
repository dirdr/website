---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Draw a digit — Adrien Pelfresne</title>
    <script is:inline>
      const theme = new URLSearchParams(location.search).get('theme');
      document.documentElement.dataset.theme =
        theme === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <main id="digit-demo">
      <div class="workspace" aria-busy="true">
        <div class="drawing">
          <canvas
            id="drawing"
            width="280"
            height="280"
            tabindex="0"
            aria-label="Draw a handwritten digit with your mouse or finger"
          ></canvas>
          <div class="actions">
            <button id="clear" type="button" disabled>
              Clear
            </button>
          </div>
        </div>
        <div class="results">
          <p class="prediction" aria-live="polite" aria-atomic="true">
            Loading model…
          </p>
          <ol class="scores" aria-label="Probability for each digit">
            {Array.from({ length: 10 }, (_, digit) => (
              <li data-digit={digit}>
                <span>{digit}</span>
                <meter
                  min="0"
                  max="1"
                  value="0"
                  aria-label={`Digit ${digit} probability`}
                />
                <span class="score">—</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <p id="status" role="status">
        Loading the neural network…
      </p>
      <noscript>This demo needs JavaScript and WebAssembly.</noscript>
    </main>
    <script>
      import '../../scripts/demos/neural-network';
    </script>
  </body>
</html>

<style>
  body {
    min-height: 0;
  }
  main {
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }
  p {
    margin: 0;
  }
  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: 1.5rem;
  }
  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: #111;
    border-radius: 0.25rem;
    touch-action: none;
    cursor: crosshair;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  button {
    border: 1px solid
      color-mix(in srgb, var(--foreground) 30%, var(--background));
    border-radius: 0.25rem;
    color: inherit;
    background: transparent;
    padding: 0.4rem 0.7rem;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  button:hover:enabled {
    background: color-mix(in srgb, var(--foreground) 6%, var(--background));
  }
  button:disabled {
    opacity: 0.45;
    cursor: wait;
  }
  .prediction {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .scores {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .scores li {
    display: grid;
    grid-template-columns: 1ch 1fr 4.5ch;
    gap: 0.6rem;
    align-items: center;
    line-height: 1.7;
  }
  .scores li[data-best] {
    font-weight: 700;
  }
  .score {
    text-align: right;
  }
  meter {
    appearance: none;
    width: 100%;
    height: 0.35rem;
    border: none;
    background: color-mix(in srgb, var(--foreground) 10%, var(--background));
    border-radius: 2px;
  }
  meter::-webkit-meter-bar {
    background: color-mix(in srgb, var(--foreground) 10%, var(--background));
    border: none;
  }
  meter::-webkit-meter-optimum-value {
    background: var(--foreground);
  }
  meter::-moz-meter-bar {
    background: var(--foreground);
  }
  #status {
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  @media (max-width: 520px) {
    .workspace {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .drawing {
      width: min(100%, 280px);
    }
  }
</style>
