---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.lastEdited.getTime() - a.data.lastEdited.getTime() ||
    a.id.localeCompare(b.id),
);
---

<BaseLayout>
  {posts.length > 0 && (
    <ul class="blog-list">
      {posts.map((post) => (
        <li>
          <a class="blog-row" href={`/writing/${post.id}/`}>
            <div class="blog-copy">
              <h2>
                <span>{post.data.title}</span>
              </h2>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
            <time datetime={post.data.lastEdited.toISOString()}>
              <span class="date-label">Last edited </span>
              {post.data.lastEdited.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .blog-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--foreground) 12%, var(--background));
    color: inherit;
    text-decoration: none;
  }

  h2 {
    display: flex;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .blog-copy {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    flex: 1;
  }

  .blog-copy p {
    max-width: 28rem;
    margin: 0;
    color: color-mix(in srgb, var(--foreground) 75%, var(--background));
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  time {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--foreground) 75%, var(--background));
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-row:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .blog-row:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (min-width: 40rem) {
    .blog-row {
      gap: 2rem;
    }
  }

  @media (max-width: 39.999rem) {
    .date-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
