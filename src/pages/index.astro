---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/about/adrien-pelfresne.jpg';
---

<BaseLayout>
  <div class="introduction-copy">
    <Image
      class="introduction-image"
      src={portrait}
      alt="Adrien Pelfresne"
      widths={[320, 640, 960]}
      sizes="(max-width: 26.5rem) calc(100vw - 2.5rem), 24rem"
      loading="eager"
      fetchpriority="high"
    />
    <p>
      Hi there, I'm Adrien Pelfresne, a software engineer and competitive{' '}
      <a href="/areas/streetlifting/">streetlifter</a> based in Paris, France. I
      like distributed systems, observability, Rust 🦀 and well-crafted
      software.
    </p>
    <p>
      I’m also a co-founder of <a href="https://palarena.com/fr/">Palarena</a>,
      where I build the infrastructure, CI/CD pipelines, and observability
      stack.
    </p>
    <p>
      I hold an french engineering degree <em>'diplôme d'ingénieur'</em> from
      ESIEE Paris and currently work at{' '}
      <a href="https://numspot.com">Numspot</a>. Read more about my{' '}
      <a href="/resume/">experience</a>.
    </p>
    <p>
      I share my <a href="/projects/">projects</a> and write{' '}
      <a href="/writing/">articles</a> about whatever sparks my curiosity.
    </p>
    <p>
      Feel free to reach out through the <a href="/contact/">contact page</a>.
    </p>
    <p>Have a wonderful day!</p>
  </div>
</BaseLayout>

<style>
  .introduction-copy {
    display: flow-root;
  }

  .introduction-image {
    float: left;
    display: block;
    width: min(100%, 16rem);
    height: auto;
    border-radius: 0.25rem;
    margin: 0 1.5rem 1rem 0;
  }

  @media (max-width: 640px) {
    .introduction-image {
      float: none;
      margin: 0 0 1.5rem;
    }
  }
</style>
