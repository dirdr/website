---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  description?: string | undefined;
}

const { description } = Astro.props;
const navigation = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/areas/', label: 'Areas' },
  { href: '/writing/', label: 'Writing' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>Adrien Pelfresne</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Fall back to the system preference when storage is unavailable.
        }
        document.documentElement.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
  </head>
  <body transition:animate="none">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header page-width">
      <a class="site-name" href="/" data-astro-prefetch="load">
        Adrien Pelfresne
      </a>
      <nav aria-label="Main">
        <ul>
          {navigation.map(({ href, label }) => (
            <li>
              <a
                href={href}
                data-astro-prefetch="load"
                aria-current={Astro.url.pathname === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </header>
    <main class="page-width" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer page-width">
      <small>&copy; {new Date().getUTCFullYear()} Adrien Pelfresne</small>
    </footer>
    <script>
      function updateExternalLinks() {
        document
          .querySelectorAll<HTMLAnchorElement>('a[href]')
          .forEach((link) => {
            const url = new URL(link.href);
            if (
              !['http:', 'https:'].includes(url.protocol) ||
              url.origin === location.origin
            )
              return;
            link.target = '_blank';
            link.relList.add('noopener', 'noreferrer');
          });
      }

      document.addEventListener('astro:page-load', updateExternalLinks);
    </script>
  </body>
</html>
