---
interface Props {
  title: string;
  period: string;
  organization: string;
  href?: string;
  context?: string;
}

const { title, period, organization, href, context } = Astro.props;
---

<section class="resume-entry">
  <header class="entry-heading">
    <h3>{title}</h3>
    <p class="entry-period">{period}</p>
    <p class="entry-organization">
      {href ? <a href={href}>{organization}</a> : organization}
      {context && <span class="entry-context"> - {context}</span>}
    </p>
  </header>
  {Astro.slots.has('default') && (
    <div class="entry-content">
      <slot />
    </div>
  )}
</section>

<style>
  .resume-entry {
    margin-top: 1.25rem;
  }

  .entry-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.125rem 1.25rem;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
    text-wrap: pretty;
  }

  p {
    margin: 0;
  }

  .entry-period {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .entry-organization {
    grid-column: 1 / -1;
    font-size: 1rem;
  }

  .entry-organization a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .entry-context {
    color: color-mix(in srgb, var(--foreground) 75%, var(--background));
    font-style: italic;
  }

  .entry-content :global(ul) {
    margin: 0.5rem 0 0;
    padding-left: 1.125rem;
  }

  .entry-content :global(li + li) {
    margin-top: 0.375rem;
  }

  .entry-content :global(p) {
    margin: 0;
  }

  @media (max-width: 40rem) {
    .entry-heading {
      grid-template-columns: minmax(0, 1fr);
    }

    .entry-organization {
      grid-row: 2;
    }

    .entry-period {
      grid-row: 3;
      color: color-mix(in srgb, var(--foreground) 75%, var(--background));
    }
  }
</style>
