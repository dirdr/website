{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.3.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node --test scripts/test-wasm.mjs",
    "test:demos": "node --test scripts/test-wasm.mjs scripts/test-molecular.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "npm run format:check && npm run lint && npm run test:demos && npm run check && npm run build",
    "pages:dev": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy --branch=main"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "astro": "^7.4.1",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.151.2"
  }
}
